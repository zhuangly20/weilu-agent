# 清心圆桌 · 环境变量模板（复制为 .env 后填写）

# 本服务对清小搭网关的鉴权密钥（接入向导里填的 credential）
# 生成方式：python -c "import secrets; print('sk-weilu-' + secrets.token_hex(16))"
WEILU_API_KEY=sk-weilu-change-me

# 本服务的公网地址（构建明信片附件的下载URL用）
# 子域名方案：https://weilu.example.com；路径前缀方案：https://现有域名/weilu
PUBLIC_BASE_URL=https://weilu.example.com

# 流式节奏（发言一条条出现）：false 可关闭；数值单位为毫秒
WEILU_PACING=true
WEILU_PACE_CHAR_MS=6
WEILU_PACE_PAUSE_MS=180
# 脚本化回复（菜单/危机提示）用更轻的节奏
WEILU_SCRIPT_PACE_CHAR_MS=2
WEILU_SCRIPT_PACE_PAUSE_MS=80

# 圆桌画会文生图（OpenAI 兼容 /images/generations；不填则默认复用 XCODE_MAIN 供应商）
# IMAGE_BASE_URL=https://xcode.best/v1
# IMAGE_API_KEY=sk-xxx
IMAGE_MODEL=gpt-image-2

# 模型供应商（OpenAI 兼容，按顺序主备切换）
AI_PROVIDER_IDS=DEEPSEEK_MAIN,XCODE_MAIN,SILICONFLOW_MAIN

AI_PROVIDER_DEEPSEEK_MAIN_BASE_URL=https://api.deepseek.com
AI_PROVIDER_DEEPSEEK_MAIN_API_KEY=sk-xxx
AI_PROVIDER_DEEPSEEK_MAIN_MODEL=deepseek-v4-flash

AI_PROVIDER_XCODE_MAIN_BASE_URL=https://xcode.best/v1
AI_PROVIDER_XCODE_MAIN_API_KEY=sk-xxx
AI_PROVIDER_XCODE_MAIN_MODEL=gpt-5.4

AI_PROVIDER_SILICONFLOW_MAIN_BASE_URL=https://api.siliconflow.cn
AI_PROVIDER_SILICONFLOW_MAIN_API_KEY=sk-xxx
AI_PROVIDER_SILICONFLOW_MAIN_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 未配置 AI_PROVIDER_IDS 时退回到单供应商：
# AI_BASE_URL=https://api.siliconflow.cn
# AI_API_KEY=sk-xxx
# AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
